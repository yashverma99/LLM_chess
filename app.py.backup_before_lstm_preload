
import time

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field

from engine.board import ChessBoard
from engine.fen import to_fen
from engine.hybrid import select_move
from engine.evaluation import evaluate_position
from engine.legal_moves import (
    generate_legal_moves,
    make_move,
    undo_move,
    is_in_check,
)
from engine.san import move_to_san


app = FastAPI(title="Formulon Chess API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=[
        "http://localhost:5173",
        "http://127.0.0.1:5173",
    ],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

board = ChessBoard()
history = []
undo_stack = []

DIFFICULTY_DEPTHS = {
    "easy": 1,
    "medium": 2,
    "hard": 3,
    "expert": 4,
}

current_difficulty = "hard"
last_ai_stats = {}


class MoveRequest(BaseModel):
    from_square: str
    to_square: str


class DifficultyRequest(BaseModel):
    difficulty: str = Field(min_length=1)


def get_status():
    legal_moves = generate_legal_moves(board)

    if not legal_moves:
        if is_in_check(board, board.turn):
            return "checkmate"
        return "stalemate"

    if is_in_check(board, board.turn):
        return "check"

    return "playing"


def get_game_state():
    game_status = get_status()

    winner = None
    if game_status == "checkmate":
        winner = "white" if board.turn == "b" else "black"

    return {
        "fen": to_fen(board),
        "history": history.copy(),
        "turn": board.turn,
        "status": game_status,
        "winner": winner,
        "moves_played": len(history),
        "difficulty": current_difficulty,
        "evaluation": evaluate_position(board),
    }


@app.get("/")
def root():
    return {"message": "Formulon Chess API is running"}


@app.get("/api/status")
def status():
    return {
        **get_game_state(),
        "ai_stats": last_ai_stats.copy(),
    }


@app.post("/api/new-game")
def new_game():
    global board, history, undo_stack, last_ai_stats

    board = ChessBoard()
    history = []
    undo_stack = []
    last_ai_stats = {}

    return get_game_state()


@app.get("/api/evaluation")
def evaluation():
    return {
        "score": evaluate_position(board),
        "perspective": "white",
        "fen": to_fen(board),
    }


@app.get("/api/difficulty")
def get_difficulty():
    return {
        "difficulty": current_difficulty,
        "depth": DIFFICULTY_DEPTHS[current_difficulty],
        "available_levels": DIFFICULTY_DEPTHS,
    }


@app.post("/api/difficulty")
def set_difficulty(request: DifficultyRequest):
    global current_difficulty

    level = request.difficulty.strip().lower()

    if level not in DIFFICULTY_DEPTHS:
        raise HTTPException(
            status_code=400,
            detail="Difficulty must be easy, medium, hard, or expert",
        )

    current_difficulty = level

    return {
        "difficulty": current_difficulty,
        "depth": DIFFICULTY_DEPTHS[current_difficulty],
    }


@app.post("/api/move")
def player_move(request: MoveRequest):
    if board.turn != "w":
        raise HTTPException(status_code=400, detail="It is not White's turn")

    if get_status() in ("checkmate", "stalemate"):
        raise HTTPException(status_code=400, detail="Game is over")

    try:
        from_index = board.square_to_index(request.from_square)
        to_index = board.square_to_index(request.to_square)
        move = (from_index, to_index)

        if move not in generate_legal_moves(board):
            raise HTTPException(status_code=400, detail="Illegal move")

        san = move_to_san(board, move)
        old_state = make_move(board, move)

        undo_stack.append((move, old_state))
        history.append(san)

        return {
            **get_game_state(),
            "last_move": san,
        }

    except HTTPException:
        raise
    except Exception as error:
        raise HTTPException(status_code=400, detail=str(error))


@app.post("/api/ai-move")
def ai_move():
    global last_ai_stats

    if board.turn != "b":
        raise HTTPException(status_code=400, detail="It is not Black's turn")

    if get_status() in ("checkmate", "stalemate"):
        raise HTTPException(status_code=400, detail="Game is over")

    try:
        depth = DIFFICULTY_DEPTHS[current_difficulty]

        start_time = time.perf_counter()

        move, score, stats = select_move(
            board,
            history=history,
            depth=depth,
        )

        thinking_time = time.perf_counter() - start_time

        if move is None:
            return get_game_state()

        san = move_to_san(board, move)
        old_state = make_move(board, move)

        undo_stack.append((move, old_state))
        history.append(san)

        last_ai_stats = {
            **stats,
            "score": score,
            "difficulty": current_difficulty,
            "requested_depth": depth,
            "thinking_time_seconds": round(thinking_time, 3),
        }

        return {
            **get_game_state(),
            "last_move": san,
            "ai_score": score,
            "ai_stats": last_ai_stats.copy(),
        }

    except Exception as error:
        raise HTTPException(status_code=500, detail=str(error))


@app.post("/api/undo")
def undo():
    global last_ai_stats

    if not undo_stack:
        raise HTTPException(status_code=400, detail="No moves to undo")

    move, old_state = undo_stack.pop()
    undo_move(board, move, old_state)
    history.pop()

    last_ai_stats = {}

    return get_game_state()
