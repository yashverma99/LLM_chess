from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

from engine.board import ChessBoard
from engine.fen import to_fen
from engine.hybrid import select_move
from engine.legal_moves import generate_legal_moves, make_move, undo_move, is_in_check
from engine.san import move_to_san


app = FastAPI(title="Formulon Chess API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

board = ChessBoard()
history = []
undo_stack = []


class MoveRequest(BaseModel):
    from_square: str
    to_square: str


def get_status():
    legal_moves = generate_legal_moves(board)

    if not legal_moves:
        if is_in_check(board, board.turn):
            return "checkmate"
        return "stalemate"

    if is_in_check(board, board.turn):
        return "check"

    return "playing"


def get_game_state():
    return {
        "fen": to_fen(board),
        "history": history,
        "turn": board.turn,
        "status": get_status(),
        "moves_played": len(history),
    }


@app.get("/")
def root():
    return {"message": "Formulon Chess API is running"}


@app.get("/api/status")
def status():
    return get_game_state()


@app.post("/api/new-game")
def new_game():
    global board, history, undo_stack

    board = ChessBoard()
    history = []
    undo_stack = []

    return get_game_state()


@app.post("/api/move")
def player_move(request: MoveRequest):
    if board.turn != "w":
        raise HTTPException(status_code=400, detail="It is not White's turn")

    if get_status() in ("checkmate", "stalemate"):
        raise HTTPException(status_code=400, detail="Game is over")

    try:
        from_index = board.square_to_index(request.from_square)
        to_index = board.square_to_index(request.to_square)
        move = (from_index, to_index)

        if move not in generate_legal_moves(board):
            raise HTTPException(status_code=400, detail="Illegal move")

        san = move_to_san(board, move)
        old_state = make_move(board, move)

        undo_stack.append((move, old_state))
        history.append(san)

        return {
            **get_game_state(),
            "last_move": san,
        }

    except HTTPException:
        raise
    except Exception as error:
        raise HTTPException(status_code=400, detail=str(error))


@app.post("/api/ai-move")
def ai_move():
    if board.turn != "b":
        raise HTTPException(status_code=400, detail="It is not Black's turn")

    if get_status() in ("checkmate", "stalemate"):
        raise HTTPException(status_code=400, detail="Game is over")

    try:
        move, score, stats = select_move(
            board,
            history=history,
            depth=3,
        )

        if move is None:
            return get_game_state()

        san = move_to_san(board, move)
        old_state = make_move(board, move)

        undo_stack.append((move, old_state))
        history.append(san)

        return {
            **get_game_state(),
            "last_move": san,
            "ai_score": score,
            "ai_stats": stats,
        }

    except Exception as error:
        raise HTTPException(status_code=500, detail=str(error))


@app.post("/api/undo")
def undo():
    if not undo_stack:
        raise HTTPException(status_code=400, detail="No moves to undo")

    move, old_state = undo_stack.pop()
    undo_move(board, move, old_state)
    history.pop()

    return get_game_state()
