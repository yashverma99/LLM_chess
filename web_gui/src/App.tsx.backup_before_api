
import { useState } from 'react'
import { Chess, type Square } from 'chess.js'
import { Chessboard } from 'react-chessboard'
import './App.css'

function App() {
  const [game, setGame] = useState(() => new Chess())
  const [history, setHistory] = useState<string[]>([])
  const [orientation, setOrientation] = useState<'white' | 'black'>('white')
  const [status, setStatus] = useState('Your move')
  const [thinking, setThinking] = useState(false)

  function updateGame(nextGame: Chess) {
    setGame(nextGame)
    setHistory(nextGame.history())
    
    if (nextGame.isCheckmate()) {
      setStatus('Checkmate!')
    } else if (nextGame.isDraw()) {
      setStatus('Game drawn')
    } else if (nextGame.isCheck()) {
      setStatus('Check!')
    } else {
      setStatus(nextGame.turn() === 'w' ? 'White to move' : 'Black to move')
    }
  }

  function makeMove(from: Square, to: Square) {
    try {
      const nextGame = new Chess(game.fen())
      const move = nextGame.move({ from, to, promotion: 'q' })

      if (!move) return false

      updateGame(nextGame)
      return true
    } catch {
      return false
    }
  }

  function onDrop({
    sourceSquare,
    targetSquare,
  }: {
    sourceSquare: Square
    targetSquare: Square | null
  }) {
    if (!targetSquare || game.isGameOver() || thinking) return false
    return makeMove(sourceSquare, targetSquare)
  }

  function newGame() {
    setThinking(false)
    updateGame(new Chess())
  }

  function undoMove() {
    const nextGame = new Chess(game.fen())
    nextGame.undo()
    updateGame(nextGame)
  }

  function flipBoard() {
    setOrientation(current => current === 'white' ? 'black' : 'white')
  }

  const movePairs: string[][] = []
  for (let i = 0; i < history.length; i += 2) {
    movePairs.push(history.slice(i, i + 2))
  }

  return (
    <div className="app">
      <header className="topbar">
        <div className="brand">
          <span className="brand-icon">♞</span>
          <span>FORMULON CHESS</span>
        </div>
        <nav>
          <span className="active">Play</span>
          <span>Analysis</span>
          <span>Learn</span>
        </nav>
        <div className="online-status">
          <span className="green-dot" /> Engine ready
        </div>
      </header>

      <main className="main-layout">
        <section className="game-area">
          <div className="player-card">
            <div className="avatar">♟</div>
            <div>
              <strong>Hybrid AI</strong>
              <small>Computer · LSTM + Minimax</small>
            </div>
            <span className="rating">AI</span>
          </div>

          <div className="board-wrapper">
            <div className="board-container">
              <Chessboard
                options={{
                  position: game.fen(),
                  onPieceDrop: onDrop,
                  boardOrientation: orientation,
                  allowDragging: !game.isGameOver() && !thinking,
                  animationDuration: 180,
                  boardStyle: {
                    borderRadius: '4px',
                    boxShadow: '0 12px 35px rgba(0,0,0,0.35)',
                  },
                }}
              />
            </div>
          </div>

          <div className="player-card bottom-player">
            <div className="avatar user-avatar">♙</div>
            <div>
              <strong>You</strong>
              <small>White · Human player</small>
            </div>
            <span className="rating">YOU</span>
          </div>

          <div className="game-controls">
            <button onClick={newGame}>＋ New Game</button>
            <button onClick={undoMove} disabled={history.length === 0}>
              ↶ Undo
            </button>
            <button onClick={flipBoard}>⇅ Flip Board</button>
          </div>
        </section>

        <aside className="side-panel">
          <div className="panel-heading">
            <h2>Game</h2>
            <span className="live-tag">LIVE</span>
          </div>

          <div className="status-card">
            <div className="status-indicator" />
            <div>
              <strong>{status}</strong>
              <small>{game.isGameOver() ? 'Game finished' : 'Casual game'}</small>
            </div>
          </div>

          <div className="moves-section">
            <h3>Move History</h3>
            <div className="moves-list">
              {movePairs.length === 0 ? (
                <div className="empty-moves">
                  Make your first move to begin.
                </div>
              ) : (
                movePairs.map((pair, index) => (
                  <div className="move-row" key={index}>
                    <span className="move-number">{index + 1}.</span>
                    <span>{pair[0]}</span>
                    <span>{pair[1] || '...'}</span>
                  </div>
                ))
              )}
            </div>
          </div>

          <div className="ai-panel">
            <div className="ai-title">
              <span>✦</span>
              <h3>AI Analysis</h3>
            </div>
            <p>
              {thinking
                ? 'AI is calculating...'
                : 'Your hybrid chess engine will provide move suggestions here.'}
            </p>
            <div className="ai-details">
              <div><span>Engine</span><strong>LSTM + Minimax</strong></div>
              <div><span>Search</span><strong>Alpha-Beta</strong></div>
              <div><span>Depth</span><strong>3</strong></div>
            </div>
          </div>

          <div className="game-info">
            <h3>Game Information</h3>
            <div><span>Moves played</span><strong>{history.length}</strong></div>
            <div><span>Turn</span><strong>{game.turn() === 'w' ? 'White' : 'Black'}</strong></div>
            <div><span>Mode</span><strong>Human vs AI</strong></div>
          </div>
        </aside>
      </main>

      <footer>
        <span>FORMULON CHESS ENGINE</span>
        <span>Powered by LSTM + Minimax</span>
      </footer>
    </div>
  )
}

export default App
