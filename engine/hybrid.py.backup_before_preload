from pathlib import Path
from functools import lru_cache

from chess_lstm.inference import predict_candidate_moves
from engine.legal_moves import generate_legal_moves, make_move, undo_move
from engine.search import INF, minimax, find_best_move


DEFAULT_MODEL_PATH = (
    Path(__file__).resolve().parents[1] / "chess_lstm" / "chess_model.keras"
)
DEFAULT_TOKENIZER_PATH = (
    Path(__file__).resolve().parents[1]
    / "dataset"
    / "processed"
    / "chess_tokenizer.json"
)


@lru_cache(maxsize=1)
def _load_default_lstm():
    from chess_lstm.model import load_model
    from chess_lstm.tokenizer import ChessTokenizer

    model = load_model(DEFAULT_MODEL_PATH)
    tokenizer = ChessTokenizer.load(DEFAULT_TOKENIZER_PATH)
    return model, tokenizer


def _load_lstm(model=None, tokenizer=None, model_path=None, tokenizer_path=None):
    if model is not None and tokenizer is not None:
        return model, tokenizer

    if model_path is None and tokenizer_path is None:
        return _load_default_lstm()

    from chess_lstm.model import load_model
    from chess_lstm.tokenizer import ChessTokenizer

    return (
        load_model(model_path or DEFAULT_MODEL_PATH),
        ChessTokenizer.load(tokenizer_path or DEFAULT_TOKENIZER_PATH),
    )


def _ordered_legal_moves(board, legal_moves, candidates):
    candidate_moves = []
    for candidate in candidates:
        if not isinstance(candidate, (tuple, list)) or len(candidate) < 2:
            continue
        move = tuple(candidate[1])
        if move in legal_moves and move not in candidate_moves:
            candidate_moves.append(move)

    return candidate_moves + [
        move for move in legal_moves if move not in candidate_moves
    ]


def _search_ordered_moves(board, moves, depth, stats=None):
    maximizing = board.turn == "w"
    best_move = None
    best_score = -INF if maximizing else INF
    alpha = -INF
    beta = INF

    for move in moves:
        if stats is not None:
            stats["root_searched"] = stats.get("root_searched", 0) + 1
        old_state = make_move(board, move)
        try:
            score = minimax(board, depth - 1, alpha, beta, not maximizing, stats)
        finally:
            undo_move(board, move, old_state)

        if maximizing and score > best_score:
            best_move, best_score = move, score
            alpha = max(alpha, best_score)
        elif not maximizing and score < best_score:
            best_move, best_score = move, score
            beta = min(beta, best_score)

    return best_move, best_score


def select_move(
    board,
    history=None,
    depth=3,
    model=None,
    tokenizer=None,
    model_path=None,
    tokenizer_path=None,
    top_k=5,
):
    """Select a legal move using LSTM ordering and alpha-beta search.

    The LSTM only changes root move ordering. Every legal root move is still
    searched by the engine, and no model output is applied directly.
    """
    if depth < 1:
        raise ValueError("Depth must be at least 1")

    legal_moves = generate_legal_moves(board)
    stats = {
        "depth": depth,
        "legal_moves": len(legal_moves),
        "searched_moves": 0,
        "lstm_candidates": 0,
        "mode": "engine-fallback",
        "nodes": 0,
        "cutoffs": 0,
    }
    if not legal_moves:
        return None, None, stats

    candidates = []
    lstm_error = None
    try:
        lstm_model, lstm_tokenizer = _load_lstm(
            model, tokenizer, model_path, tokenizer_path
        )
        sequence_length = lstm_model.input_shape[1]
        candidates = predict_candidate_moves(
            board,
            history or [],
            lstm_model,
            lstm_tokenizer,
            sequence_length,
            top_k=top_k,
        )
        stats["mode"] = "lstm-guided" if candidates else "engine-fallback"
    except (ImportError, OSError, RuntimeError, TypeError, ValueError) as error:
        lstm_error = str(error)

    if lstm_error:
        stats["lstm_error"] = lstm_error
        best_move, score = find_best_move(board, depth, stats)
        stats["searched_moves"] = len(legal_moves)
        return best_move, score, stats

    ordered_moves = _ordered_legal_moves(board, legal_moves, candidates)
    stats["lstm_candidates"] = len(
        {tuple(candidate[1]) for candidate in candidates if len(candidate) >= 2}
    )
    stats["searched_moves"] = len(ordered_moves)
    best_move, score = _search_ordered_moves(board, ordered_moves, depth, stats)
    return best_move, score, stats


find_hybrid_move = select_move

